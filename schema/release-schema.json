{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiscogsPhysicalRelease",
  "type": "object",
  "required": ["title", "artists", "format", "country", "released", "tracklist"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "artists": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "format": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Cassette", "Vinyl", "CD", "Album", "Compilation", "Unofficial Release", "Reissue", "LP", "EP", "Single"]
      },
      "minItems": 1
    },
    "country": { "type": "string", "minLength": 1 },
    "released": { "type": ["string", "integer", "null"], "pattern": "^[0-9]{4}$" },
    "label": { "type": "string", "minLength": 1 },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "identifiers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "catalog_number": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9\\-\\.\\/ ]+$" },
    "barcode": { "type": ["string", "null"], "pattern": "^[0-9\\- ]+$" },
    "genre": {
      "type": "array",
      "items": { "type": "string" }
    },
    "style": {
      "type": "array",
      "items": { "type": "string" }
    },
    "credits": {
      "type": "object",
      "properties": {
        "executive_producer": { "type": "string" },
        "cover_and_package_design": { "type": "string" },
        "promotion": { "type": "string" },
        "cover_photo": { "type": "string" },
        "published_by": { "type": "string" },
        "arrangement": { "type": "string" },
        "engineered_by": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" },
    "tracklist": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["position", "artist", "title"],
        "properties": {
          "position": { "type": "string", "pattern": "^[A-B][0-9]+$" },
          "artist": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "duration": { "type": ["string", "null"], "pattern": "^[0-9]{1,2}:[0-9]{2}$" }
        },
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extra": {
      "type": "object",
      "properties": {
        "poets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ensemble": { "type": "string" },
        "art_description": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
